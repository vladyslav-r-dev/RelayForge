# Copy to .env and replace both placeholders with independently generated random hex values.
POSTGRES_PASSWORD=replace-with-random-hex-password
RELAYFORGE_API_KEY=replace-with-random-hex-api-key
# Replace with the exact HTTPS URL of a receiver you control and trust.
RELAYFORGE_RECEIVER_URL=https://receiver.example/webhook
API_PORT=8080
POSTGRES_PORT=5433
